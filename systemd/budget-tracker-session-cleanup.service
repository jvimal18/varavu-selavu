[Unit]
Description=VaravuSelavu monthly session table cleanup (deletes long-expired + stale-revoked rows)
# No [Install] section — this unit is pulled in by budget-tracker-session-cleanup.timer.

[Service]
Type=oneshot
User=budget
WorkingDirectory=/var/lib/budget-tracker
ExecStart=/usr/bin/node /var/lib/budget-tracker/scripts/cleanup-sessions.mjs
