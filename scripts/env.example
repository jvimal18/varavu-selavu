# scripts/.env — deploy/export configuration (this file is gitignored)
#
# Copy this file to scripts/.env and edit values as needed.
# Every value below is already the default the scripts use, so you can
# leave the file absent entirely until you need to override something.
# Values must NOT contain spaces (they are embedded in ssh/rsync commands).

# --- Pi connection ----------------------------------------------------------
PI_HOST=192.168.0.224
PI_USER=vimal
# Extra ssh options, e.g. PI_SSH_OPTS="-i ~/.ssh/id_pi"  (default: empty)
PI_SSH_OPTS=

# --- App paths --------------------------------------------------------------
PI_APP_DIR=/var/lib/budget-tracker
# Privilege prefix for commands that write to system paths. Keep "sudo".
# (If you set this empty, make sure ${PI_USER} can write to ${PI_APP_DIR}
# directly — otherwise rsync + remote installs will fail.)
PI_SUDO=sudo

# --- rclone (nightly export to Google Drive) --------------------------------
RCLONE_REMOTE=gdrive:budget-tracker-backups/
RCLONE_MAX_AGE=30d
