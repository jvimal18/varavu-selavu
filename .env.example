# Required in production. Generate with: openssl rand -hex 32
NUXT_SESSION_SECRET=replace-me-with-32-bytes-of-random-hex

# Path to the SQLite database file
NUXT_DB_PATH=./data/dev.db

# CSRF: comma-separated allowlist of origins permitted to make
# state-changing requests to /api/* (POST/PATCH/PUT/DELETE).
# The CSRF middleware (server/middleware/00.csrf.ts) checks the
# `Origin` header against this list and rejects everything else with 403.
#
# MUST be set in production. If left empty in production, the middleware
# rejects every state-changing request. Set to your Tailscale Funnel URL
# (and the LAN origin if you ever access directly):
#   NUXT_ALLOWED_ORIGINS=https://your-funnel.example.com,http://192.168.0.224:3000
#
# Dev default: http://localhost:3000
# NUXT_ALLOWED_ORIGINS=http://localhost:3000

# CSP: when true, the security-headers middleware sets
# `Content-Security-Policy` (enforcing). When false (the default for new
# deploys), it sets `Content-Security-Policy-Report-Only` instead so you
# can verify the dashboard charts (donut, cash-flow, daily-spends) load
# without violations before flipping the switch.
#   NUXT_CSP_ENFORCE=true
