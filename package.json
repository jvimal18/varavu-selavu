{
  "name": "varavuselavu",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal budget tracker for Vimal & Pavithra",
  "scripts": {
    "predev": "node scripts/generate-version-json.mjs",
    "dev": "nuxt dev",
    "prebuild": "node scripts/generate-version-json.mjs",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "rm -f $NUXT_DB_PATH && pnpm db:migrate && pnpm db:seed",
    "export": "node scripts/export.mjs",
    "import": "tsx scripts/import.ts"
  },
  "dependencies": {
    "@nuxt/icon": "^1.5.6",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.5.5",
    "@vueuse/core": "^11.2.0",
    "@vueuse/nuxt": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "echarts": "^5.5.1",
    "h3": "^1.13.0",
    "nuxt": "^3.13.2",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
